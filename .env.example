APP_NAME=irnoti
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

# Public site theme — drives every color on the marketing site (config/theme.php)
THEME_PRIMARY="#ff3000"
THEME_ACCENT="#ff8a3d"
THEME_SECONDARY="#0bc5a3"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Admin user created by `php artisan db:seed` (change before seeding on production)
ADMIN_NAME="مدیر irnoti"
ADMIN_EMAIL=admin@irnoti.com
ADMIN_PASSWORD=change-me

# SMS provider (docs/starter.md §12/§13) — never hard-code credentials.
# "log" = credential-free dev driver (writes to the log, like PAYMENT_DRIVER=local).
# Switch to "pasargad" and fill the credentials for real delivery.
# SMS_PROVIDER_LABEL is the brand-neutral name customers see (never the real vendor);
# it can also be set from the admin panel (تنظیمات).
SMS_PROVIDER=log
SMS_PROVIDER_LABEL="سامانه پیامک"
SMS_PASARGAD_USERNAME=
SMS_PASARGAD_PASSWORD=
SMS_PASARGAD_API_KEY=
SMS_PASARGAD_SENDER=

# Mobile that receives the admin copy of operation notifications (docs/starter.md §44)
ADMIN_MOBILE=

# Payment gateway (shetabit/multipay). "local" = built-in test gateway (no creds).
# Switch to zarinpal / saman / … and fill the driver's credentials in config/payment.php.
# Online line purchases are also gated by the "خرید آنلاین خطوط" setting in the admin panel.
PAYMENT_DRIVER=local
ZARINPAL_MERCHANT_ID=
ZARINPAL_MODE=normal

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
